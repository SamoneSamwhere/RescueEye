# Used by `npm run android:apk` (vite --mode mobile) on top of .env.
# A phone cannot reach 127.0.0.1 on this laptop. This is the Cloudflare quick
# tunnel to the API (tools/cloudflared.exe tunnel --url http://localhost:8000),
# so the app works on any network. The address changes every time the tunnel
# restarts: update it here and rebuild. On the same Wi-Fi only, the laptop's
# address works too, e.g. "http://192.168.254.195:8000".
VITE_API_BASE_URL="http://192.168.1.19:8000"

# The Android app is the Field Responder side only (see src/lib/appTarget.ts).
VITE_APP_TARGET="responder"

# Responders use real accounts; no demo sign-in or mock data in the app.
VITE_DEMO_MODE="false"
