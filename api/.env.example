HOST=0.0.0.0
PORT=8000

# ── Drone feed ────────────────────────────────────────────────────────────────
# Path to local MP4 for the simulated drone feed.
# If not set or file not found, the API uses a synthetic animated frame.
DRONE_FEED_PATH=C:/path/to/your/drone_footage.mp4

# Frames per second extracted from the MP4 (and sent to the MJPEG stream).
FRAME_RATE=1

# ── AI models ─────────────────────────────────────────────────────────────────
# Victim detection — custom-trained weights (Phase 3 output).
# Falls back to yolov8n.pt (COCO pretrained) if file does not exist.
VICTIM_MODEL_PATH=models/victim_best.pt

# Damage classification — custom-trained weights (Phase 3 output).
# Falls back to yolov8n-cls.pt (COCO pretrained) if file does not exist.
DAMAGE_MODEL_PATH=models/damage_best.pt

# Legacy single-model path (Phase 2 compat — ignored when above paths are set)
MODEL_PATH=yolov8n.pt

# Detection confidence threshold (0.0 – 1.0)
CONFIDENCE_THRESHOLD=0.40

# Log a console warning when inference exceeds this many milliseconds
LATENCY_WARN_MS=3000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Leave unset in development: the API then allows localhost and 127.0.0.1 on
# ports 5173-5180, which covers Vite moving off 5173 when that port is taken.
# Set it for a real deployment to pin exactly the origins you serve from.
# ALLOWED_ORIGINS=https://rescueeye.example.org

# Camera height above ground for footage whose telemetry carries no altitude.
# Leave unset for a live aircraft that reports its own.
# DRONE_ALTITUDE_M=40
# CAMERA_HFOV_DEG=84
# Casualty gate (services/casualty.py) - set CASUALTY_GATE=false to report
# every detected person as a casualty, the pre-gate behaviour.
# CASUALTY_GATE=true
# CASUALTY_MIN_SCORE=0.55
# GIMBAL_PITCH_DEG=-90

# SMS alerts via UniSMS (https://unismsapi.com/dashboard). Paste the API secret
# key and the sender ID shown on the dashboard, then restart the API.
SMS_PROVIDER=unisms
UNISMS_API_KEY=
UNISMS_SENDER_ID=

# Sign-in (services/auth.py): Supabase > Project Settings > JWT Keys > Legacy JWT secret
SUPABASE_JWT_SECRET=
# Built-in demo accounts, presentations only
DEMO_MODE=false
# Key a drone bridge sends as X-Device-Key to POST /drone/telemetry
DRONE_INGEST_KEY=

# Always-on drone ingest (services/drone_ingest.py). Install MediaMTX with
# `python -m scripts.get_mediamtx`. Drones stream to rtmp://<this computer>:1935/live/<name>.
INGEST_ENABLED=true
INGEST_RTMP_PORT=1935
INGEST_GRACE_S=10
